tent": "", "type": "text"}]}], "id": 0}], "type": "RSLT", "id": 10, "stimuli_ids": []}, {"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "Que mettez-vous dans votre sandwich ?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Keep trying.", "type": "text"}, {"content": "Maybe next time\u2026", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "You have 2 tries.", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "valid": 1, "type": "skill", "value": "{\"type\": \"skill\", \"content\": \"Reading\"}"}, {"content": "Writing", "valid": 1, "type": "skill", "value": "{\"type\": \"skill\", \"content\": \"Writing\"}"}, {"content": "Speaking", "valid": 1, "type": "skill", "value": "{\"type\": \"skill\", \"content\": \"Speaking\"}"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "frn1le05ob02re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "type": "DWS", "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "R\u00e9soudre des probl\u00e8mes", "type": "lesson_name"}, {"content": "Y a-t-il de la moutarde au frigo ?", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "Beginner", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "learning_points", "contents": [{"content": "Le pronom adverbial <span class=\"strong\">EN</span>", "type": "heading"}, {"content": "<span class = \"bullet\">Comme vous le savez d\u00e9j\u00e0, on distingue deux pronoms adverbiaux : <span class=\"strong\">y</span> et <span class=\"strong\">en</span>. Ils ont la m\u00eame fonction que les pronoms. Dans cette section on discute le pronom adverbial <span class=\"strong\">en</span>.</br> <span class = \"bullet\">Le pronom adverbial <span class=\"strong\">en</span> s'emploie pour \u00e9viter des r\u00e9p\u00e9titions. Il remplace un nom introduit par la pr\u00e9position <span class=\"strong\">de</span>. Par exemple :</br> 1.\t<span class=\"italic\">  Je mange des cerises. \u2192 J'en mange.</span></br> 2.\t<span class=\"italic\">  Poss\u00e8des-tu une maison ? \u2192 Non, je n'en poss\u00e8de pas une.</span></br> <span class = \"bullet\">Le pronom adverbial <span class=\"strong\">en</span> remplace des \u00e9l\u00e9ments pr\u00e9c\u00e9d\u00e9s d'un article partitif : <span class=\"strong\">du, de la, de l' </span>et <span class=\"strong\">des</span>. Par exemple :   </br>1. <span class=\"italic\">  Il y a du lait dans le frigo. \u2192 Il y en a dans le frigo.</br> 2. Marc a de l'imagination. \u2192 Il en a.</br> 3. Voulez-vous des \u00e9pinards ? \u2192 Merci, je n'en veux pas.</br> 4. Sophie joue de la guitare. \u2192 Elle en joue.</span> </br><span class = \"bullet\">Le pronom adverbial <span class=\"strong\">en</span> ne remplace jamais une personne. C'est-\u00e0-dire qu'il ne remplace que les choses inanim\u00e9es et abstraites.", "type": "describer"}]}, {"type": "learning_points", "contents": [{"content": " Les articles partitifs dans des phrases n\u00e9gatives", "type": "heading"}, {"content": "<span class = \"bullet\"><span class=\"strong\">Les articles partitifs</span> s'emploient devant les noms d\u00e9signant des choses qu'on ne peut pas compter. Ils d\u00e9signent une partie ind\u00e9termin\u00e9e des choses. Par exemple : <span class=\"italic\">  Elle fait du bruit.</span></br> <span class = \"bullet\">Dans cette section on discute les articles partitifs dans des phrases n\u00e9gatives. \u00c0 la forme n\u00e9gative : </br> - <span class=\"strong\">du, de la</span> et <span class=\"strong\">des </span>deviennent <span class=\"strong\">de</span> et</br> - <span class=\"strong\">de l' </span>devient <span class=\"strong\">d'</span>.</br> <span class = \"bullet\">Le tableau ci-dessous d\u00e9montre les articles partitifs dans des phrases affirmatives, n\u00e9gatives et interrogatives et aussi l'emploi du pronom adverbial <span class=\"strong\">en</span> :", "type": "describer"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\"> Phrases affirmatives </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\"> Phrases n\u00e9gatives </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\"> Phrases interrogatives </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Il y a <span class=\\\"strong\\\"> du</span> fromage dans le frigo.</br>  Il y <span class=\\\"strong\\\"> en</span> a dans le frigo.</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Il n'y a pas <span class=\\\"strong\\\">de</span> fromage dans le frigo.</br>  N'y a-t-il pas <span class=\\\"strong\\\">de</span> fromage dans le frigo ?</br>  Il n'y <span class=\\\"strong\\\">en</span> a pas dans le frigo.</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Y a-t-il <span class=\\\"strong\\\">du</span> fromage dans le frigo ?</br>  Est-ce qu'il y <span class=\\\"strong\\\">en</span> a dans le frigo ?</br>  Y <span class=\\\"strong\\\">en</span> a-t-il dans le frigo ?</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Il y a <span class=\\\"strong\\\"> des</span> frites sur le comptoir.</br>  Il y <span class=\\\"strong\\\"> en</span> a sur le comptoir.</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Il n'y pas <span class=\\\"strong\\\">de</span> frites sur le comptoir.</br>  N'y a-t-il pas <span class=\\\"strong\\\">de</span> frites sur le comptoir ?</br>  Il n'y <span class=\\\"strong\\\">en</span> a pas sur le comptoir.</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Y a-t-il <span class=\\\"strong\\\">des</span> frites sur le comptoir ? </br>  Est-ce qu'il y <span class=\\\"strong\\\">en</span> a sur le comptoir ?</br>  Y <span class=\\\"strong\\\">en</span> a-t-il sur le comptoir ?</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Il y a <span class=\\\"strong\\\"> de l'</span>espace dans ton bureau.</br>  Il y <span class=\\\"strong\\\"> en</span> a dans ton bureau.</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Il n'y a pas <span class=\\\"strong\\\">d'</span>espace dans ton bureau.</br>  N'y a-t-il pas <span class=\\\"strong\\\"> d'</span>espace dans ton bureau ?</br>  Il n'y <span class=\\\"strong\\\">en</span> a pas dans ton bureau.</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Y a-t-il <span class=\\\"strong\\\">de l'</span> espace dans ton bureau ?</br>  Est-ce qu'il y <span class=\\\"strong\\\">en</span> a dans ton bureau ?</br>  Y <span class=\\\"strong\\\">en</span> a-t-il dans ton bureau ?</br>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "se joindre", "type": "name"}, {"content": "s'associer \u00e0 quelqu'un ou \u00e0 un groupe pour une action commune", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : On se joint \u00e0 vous pour le d\u00eener ce soir.", "type": "example"}, {"content": "frn1le05ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots que vous pouvez employer dans une salle \u00e0 manger.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "le poivron", "type": "name"}, {"content": "une sorte de piment \u00e0 gros fruit vert, jaune ou rouge", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : J'aime les poivrons verts dans mon sandwich.", "type": "example"}, {"content": "frn1le05ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le frigo", "type": "name"}, {"content": "l'abr\u00e9viation de frigorifi\u00e9 ; un r\u00e9frig\u00e9rateur", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Nous gardons du lait et du fromage dans le frigo.", "type": "example"}, {"content": "frn1le05ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le couteau", "type": "name"}, {"content": "un instrument pour couper les fruits et les l\u00e9gumes", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Ce couteau coupe bien les tomates.", "type": "example"}, {"content": "frn1le05ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "inviter", "type": "name"}, {"content": "prier quelqu'un de venir \u00e0 un \u00e9v\u00e8nement", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Je t'invite \u00e0 la f\u00eate ce soir.", "type": "example"}, {"content": "frn1le05ob02aud05", "type": "audio"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant s'exprime et situe les objets pour interagir avec les autres. ", "type": "primary"}, {"content": "L'apprenant comprend de l'information simple, le lexique et les expressions dans des conversations courtes au sujet de l'information personnelle.", "type": "second