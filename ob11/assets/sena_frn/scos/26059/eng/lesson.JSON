"type": "text"}]}], "type": "MT1", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn1le05ob11re2img01.jpg"}, {"text": "<span class = \"strong notdialogue\">1\u00e8re conversation</span>", "id": 1, "time": "50", "image": "frn1le05ob11re2img01.jpg"}, {"text": "<span class=\"strong\">Jeanne </span>: Fabienne, pourrais-tu me rendre un service, s'il te pla\u00eet&nbsp;? Peux-tu me passer ces tomates-l\u00e0&nbsp;?\n<br /><span class=\"strong\">Fabienne </span>: Bien s\u00fbr, je t'aide volontiers, Jeanne.", "id": 2, "time": "50", "image": "frn1le05ob11re2img01.jpg"}, {"text": "<span class=\"strong\">Jeanne</span> : Merci. Il y a aussi d'autres l\u00e9gumes l\u00e0-bas. Lave-les, coupe-les et ajoute-les \u00e0 la soupe, s'il te pla\u00eet.\n<br /><span class=\"strong\">Fabienne </span>: Combien de l\u00e9gumes ?\n<br /><span class=\"strong\">Jeanne</span> : Tous les l\u00e9gumes.<br/> <br/>", "id": 3, "time": "7000", "image": "frn1le05ob11re2img01.jpg"}, {"text": "<span class = \"strong notdialogue\">2e conversation</span>", "id": 4, "time": "17000", "image": "frn1le05ob11re2img01.jpg"}, {"text": "<span class=\"strong\">Jacques</span> : Sophie, y a-t-il du caf\u00e9 ?\n<br /><span class=\"strong\">Sophie </span>: Non, il n'y en a pas.\n<br /><span class=\"strong\">Jacques</span> : Pourrais-tu en pr\u00e9parer pour la r\u00e9union, s'il te pla\u00eet ?", "id": 5, "time": "17000", "image": "frn1le05ob11re2img01.jpg"}, {"text": "<span class=\"strong\">Sophie</span> : De combien de tasses de caf\u00e9 as-tu besoin ?\n<br /><span class=\"strong\">Jacques</span> : J'ai besoin de beaucoup de caf\u00e9, deux ou trois pots. Peux-tu me passer aussi les g\u00e2teaux, s'il te pla\u00eet ?\n<br /><span class=\"strong\">Sophie </span> : Lesquels ? Ceux-ci ? Les voici !", "id": 6, "time": "23000", "image": "frn1le05ob11re2img01.jpg"}], "audiosrc": "frn1le05ob11re2aud01", "coverimg": "frn1le05ob11re2img01.jpg"}, "type": "slideshow"}], "_data": [{"content": [], "type": "tips"}], "type": "audio", "template_override": 1}]}]}